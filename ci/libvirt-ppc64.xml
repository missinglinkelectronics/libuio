<!-- No KVM, as the host is usually x86-64: QEMU emulates the CPU (TCG) -->
<domain type='qemu' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>ci-libuio-ppc64</name>
  <!-- The uuid is intentionally removed. It will be generated by libvirt. -->
  <memory unit='KiB'>1048576</memory>
  <currentMemory unit='KiB'>1048576</currentMemory>
  <vcpu placement='static'>1</vcpu>
  <!-- SLOF firmware, which boots GRUB from the PReP partition -->
  <os>
    <type arch='ppc64' machine='pseries'>hvm</type>
    <boot dev='hd'/>
  </os>
  <cpu mode='custom' match='exact'>
    <model fallback='forbid'>POWER9</model>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-ppc64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/dev/shm/ci-libuio-ppc64-overlay.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x0'/>
    </disk>
    <!-- The seed ISO is attached via SCSI, as on arm64 -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/dev/shm/ci-libuio-ppc64-seed.iso'/>
      <target dev='sda' bus='scsi'/>
      <readonly/>
    </disk>
    <!-- pseries has a conventional PCI host bridge (pci.0), not PCIe -->
    <controller type='pci' index='0' model='pci-root'>
      <model name='spapr-pci-host-bridge'/>
      <target index='0'/>
    </controller>
    <controller type='virtio-serial' index='0'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x0'/>
    </controller>
    <controller type='scsi' index='0' model='virtio-scsi'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x0'/>
    </controller>
    <controller type='usb' index='0' model='none'/>
    <!-- ci/vm-test.sh replaces this with a bridge for VM_NETWORK=bridge -->
    <interface type='user'>
      <!-- The MAC address is intentionally removed. It will be generated by libvirt. -->
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x04' function='0x0'/>
    </interface>
    <!-- Hypervisor console hvc0 -->
    <serial type='pty'>
      <target type='spapr-vio-serial' port='0'>
        <model name='spapr-vty'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <!-- Test output, written by the VM to /dev/virtio-ports/org.libuio.ci.log -->
    <channel type='file'>
      <source path='/dev/shm/ci-libuio-ppc64-test.log'/>
      <target type='virtio' name='org.libuio.ci.log'/>
      <address type='virtio-serial' controller='0' bus='0' port='2'/>
    </channel>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
      <address type='virtio-serial' controller='0' bus='0' port='1'/>
    </channel>
    <memballoon model='virtio'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x05' function='0x0'/>
    </memballoon>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x06' function='0x0'/>
    </rng>
  </devices>
  <qemu:commandline>
    <!-- Use fixed addresses, as libvirt places these arguments before its own
         devices and auto-assigned slots could collide with them -->
    <qemu:arg value='-device'/>
    <qemu:arg value='edu,bus=pci.0,addr=0x10'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='edu,bus=pci.0,addr=0x11'/>
  </qemu:commandline>
</domain>
